<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Website Bán Dụng Cụ Thể Thao</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <!-- FontAwesome Icon -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background-color: #f8f9fa;
            }

            .navbar-brand {
                font-weight: bold;
                color: #ffc107 !important;
            }

            .hero-banner {
                background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('https://images.unsplash.com/photo-1517649763962-0c623266200a?q=80&w=1200') center/cover;
                color: white;
                padding: 70px 0;
            }

            .card-product {
                transition: transform 0.2s;
                border: none;
                border-radius: 10px;
            }

                .card-product:hover {
                    transform: translateY(-5px);
                    box-shadow: 0 10px 20px rgba(0,0,0,0.15) !important;
                }

            footer {
                background-color: #212529;
                color: #adb5bd;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fs-3" href="#"><i class="fa-solid fa-dumbbell me-2"></i>NTT SPORT</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link active" href="#">Trang chủ</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">Bóng đá</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">Cầu lông</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">Gym & Yoga</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">Chạy bộ</a></li>
                    </ul>
                    <form class="d-flex me-3" role="search">
                        <input class="form-control me-2" type="search" placeholder="Tìm dụng cụ..." aria-label="Search">
                        <button class="btn btn-outline-warning" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
                    </form>
                    <div class="d-flex align-items-center">
                        <a href="#" class="btn btn-warning me-3">
                            <i class="fa-solid fa-cart-shopping"></i> Giỏ hàng (3)
                        </a>
                        <a href="#" class="btn btn-outline-light"><i class="fa-solid fa-user me-1"></i> Đăng nhập</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="mt-5 py-4 border-top">
        <div class="container text-center">
            <p class="mb-1">&copy; 2026 - Website Bán Dụng Cụ Thể Thao - Đồ Án Cơ Sở CNTT</p>
            <p class="small text-muted">GVHD: ThS. Vũ Thanh Nhàn | SVTH: Lê Quang Thuận (MSSV: 2400004948)</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>